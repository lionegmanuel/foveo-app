# =============================================================================
# .env.example — screenzoom
# Copiar como .env y completar los valores reales. .env NUNCA se versiona en git.
# =============================================================================

# -----------------------------------------------------------------------------
# ENTORNO GENERAL
# -----------------------------------------------------------------------------

# Entorno de ejecución. Afecta logging verbose, paths de dev vs. producción, etc.
# Valores: development | production
APP_ENV=development

# Nivel de logging del backend Rust (usa el crate `tracing` o `env_logger`).
# Valores típicos: error | warn | info | debug | trace
RUST_LOG=info


# -----------------------------------------------------------------------------
# FFMPEG (SIDECAR DE EXPORT)
# -----------------------------------------------------------------------------

# Ruta local al binario de ffmpeg usado por el exporter. En desarrollo apunta
# a sidecars/ffmpeg/<plataforma>/ffmpeg(.exe); en producción se resuelve
# automáticamente por Tauri como sidecar bundleado, esta variable es override
# solo para debugging local con un binario custom.
FFMPEG_BINARY_PATH=

# URL desde donde el script de setup descarga el binario de ffmpeg (build LGPL-only,
# sin libx264, con soporte NVENC/QSV/AMF/Media Foundation). Reemplazar por la fuente
# elegida (por ejemplo, un release de gyan.dev o BtbN/FFmpeg-Builds en GitHub).
FFMPEG_DOWNLOAD_URL=https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-n8.1-latest-win64-lgpl-8.1.zip

# Hash SHA256 esperado del binario descargado, para verificar integridad antes de usarlo.
FFMPEG_EXPECTED_SHA256=fc9d307266bddb972755379eee4a5ce417d1336d3d8a2dd6db6a8864638b9c6c


# -----------------------------------------------------------------------------
# AUTO-UPDATE (tauri-plugin-updater)
# -----------------------------------------------------------------------------

# Endpoint donde el updater busca el manifest de nuevas versiones (latest.json).
# Si se usa GitHub Releases: apunta al asset latest.json del release más reciente.
# Ejemplo: https://github.com/<usuario>/<repo>/releases/latest/download/latest.json
TAURI_UPDATER_ENDPOINT=

# Clave pública usada por el updater para verificar la firma de cada release.
# Se genera una sola vez con: pnpm tauri signer generate
# Esta clave SÍ va en el binario final (no es secreta), pero se referencia acá
# para no hardcodearla directo en tauri.conf.json si se prefiere manejarla por env.
TAURI_UPDATER_PUBKEY=

# Clave PRIVADA usada para firmar cada release antes de publicarlo. NUNCA se
# commitea ni se distribuye con la app. Se usa solo en el pipeline de build/release,
# no en el binario final del usuario.
TAURI_UPDATER_PRIVATE_KEY=

# Password de la clave privada de arriba, si se generó con contraseña (recomendado).
TAURI_UPDATER_PRIVATE_KEY_PASSWORD=


# -----------------------------------------------------------------------------
# CODE SIGNING — WINDOWS (Authenticode)
# PENDIENTE DE DECISIÓN: solo necesario cuando se distribuya la app a terceros.
# No requerido para uso personal ni para builds de desarrollo.
# -----------------------------------------------------------------------------

# Ruta al certificado .pfx/.p12 de firma de código, o el "thumbprint" si está
# instalado en el certificate store de Windows. Se obtiene comprando un
# certificado Authenticode (ej. DigiCert, Sectigo) o vía Azure Trusted Signing.
WINDOWS_CERTIFICATE_PATH=
WINDOWS_CERTIFICATE_PASSWORD=
WINDOWS_CERTIFICATE_THUMBPRINT=


# -----------------------------------------------------------------------------
# CODE SIGNING Y NOTARIZACIÓN — macOS
# PENDIENTE DE DECISIÓN: solo relevante a partir de la Fase 4 (puerto a Mac).
# Se obtienen desde una cuenta de Apple Developer Program (pago anual).
# -----------------------------------------------------------------------------

# Identidad de firma, tal como aparece en `security find-identity -v -p codesigning`.
APPLE_SIGNING_IDENTITY=

# Apple ID y contraseña de aplicación (no la contraseña normal de la cuenta) usados
# para el paso de notarización vía `notarytool`. La contraseña de aplicación se
# genera en appleid.apple.com > Seguridad > Contraseñas específicas de apps.
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=

# Team ID de la cuenta de Apple Developer (visible en developer.apple.com/account).
APPLE_TEAM_ID=


# -----------------------------------------------------------------------------
# CRASH REPORTING
# PENDIENTE DE DECISIÓN: no incluido en el MVP. Dejar comentado hasta decidir
# si se integra (ej. Sentry) y bajo qué condiciones de privacidad, dado que la
# app procesa grabaciones de pantalla del usuario (contenido potencialmente sensible).
# -----------------------------------------------------------------------------

# CRASH_REPORTING_DSN=
# CRASH_REPORTING_ENVIRONMENT=


# -----------------------------------------------------------------------------
# TELEMETRÍA (opcional, desactivada por defecto)
# PENDIENTE DE DECISIÓN: si se activa alguna vez, debe ser opt-in explícito del
# usuario, nunca por defecto, dado el uso personal actual del producto.
# -----------------------------------------------------------------------------

# TELEMETRY_ENABLED=false
# TELEMETRY_ENDPOINT=
# TELEMETRY_WRITE_KEY=


# -----------------------------------------------------------------------------
# LICENCIAMIENTO / ACTIVACIÓN
# PENDIENTE DE DECISIÓN DE NEGOCIO: no aplica mientras el modelo de negocio no
# esté definido (ver sección 7 de ARQUITECTURA.md). No hay backend de licensing
# en el MVP. Variables dejadas como referencia para cuando esa decisión se tome.
# -----------------------------------------------------------------------------

# LICENSE_SERVER_URL=
# LICENSE_PUBLIC_KEY=
